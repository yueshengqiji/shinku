# 配置样例。
#
# 全部键都可以不设——不设就用 src/shinku/names.py 里的契约默认值。
# 想要一份能跑的配置，把这个文件复制成 .env 再改；不要直接改本文件。
#
# ⚠️ 其他项目的 .env 不能直接搬过来：里面可能混着历史 COMPANION_* 键名，
#    那些键在本项目里会被忽略。见 README「明确不继承的两个旧命名」。

# ---- 路径（不设则按平台约定放在用户目录下）----
# SHINKU_DATA_ROOT=
# SHINKU_CONFIG_ROOT=
# SHINKU_LOG_ROOT=

# ---- 服务端口 ----
# SHINKU_BACKEND_PORT=9998
# SHINKU_RESPONSE_HOST_PORT=9995
# SHINKU_TIME_MANAGER_HOST_PORT=9996
# SHINKU_BROWSER_HOST_PORT=9997
# SHINKU_AGENT_PORT=9100

# ---- 绑定地址（默认 127.0.0.1）----
# SHINKU_BACKEND_HOST=127.0.0.1
# SHINKU_RESPONSE_HOST_BIND=127.0.0.1
# SHINKU_TIME_MANAGER_HOST_BIND=127.0.0.1
# SHINKU_BROWSER_HOST_BIND=127.0.0.1
# SHINKU_AGENT_HOST=127.0.0.1
# When a service binds to a wildcard/LAN address, use this reachable host in URLs
# generated for other services or the debug UI.
# SHINKU_SERVICE_URL_HOST=127.0.0.1

# ---- 局域网暴露（默认关；开了才会把绑定地址默认改成 0.0.0.0）----
# SHINKU_ALLOW_LAN=false

# ---- 服务间令牌（二选一；直接用值优先于读文件）----
# SHINKU_SERVICE_TOKEN=
# SHINKU_SERVICE_TOKEN_FILE=

# ---- NapCat HTTP action（不设则不连接 QQ）----
# SHINKU_NAPCAT_BASE_URL=http://127.0.0.1:3000
# SHINKU_NAPCAT_ACCESS_TOKEN=
# SHINKU_NAPCAT_ACCESS_TOKEN_FILE=
# SHINKU_NAPCAT_TIMEOUT=30
# SHINKU_NAPCAT_WEBHOOK_ENABLED=false
# SHINKU_NAPCAT_WEBHOOK_PATH=/events/napcat
# SHINKU_NAPCAT_EVENT_TOKEN=
# SHINKU_NAPCAT_IMAGE_ROOTS=

# ---- 独立 QQ Agent（默认关闭；开启后仍默认 dry-run）----
# SHINKU_QQ_AGENT_ENABLED=false
# SHINKU_QQ_AGENT_SEND_ENABLED=false
# 已登记 Agent 的群聊和私聊默认最多互答两次；逗号分隔账号。
# SHINKU_QQ_AGENT_PEER_IDS=
# 仅以下已登记账号的私聊不限次数，群聊限额、消息去重和工具权限继续生效。
# SHINKU_QQ_AGENT_PEER_PRIVATE_UNLIMITED_IDS=
# SHINKU_PERSONA_FILE=
# SHINKU_CHAT_API_KEY=
# SHINKU_CHAT_BASE_URL=
# SHINKU_CHAT_API_PROTOCOL=openai
# SHINKU_CHAT_MODEL_NAME=
# Optional local model-service registry used by the control center.
# SHINKU_MODEL_SERVICES_PATH=
# SHINKU_CHAT_METRICS_PATH=
# LLM transport policy. Defaults preserve the current 90s/120s timeout and retry behavior.
# SHINKU_LLM_AUX_TIMEOUT_SECONDS=90
# SHINKU_LLM_CHAT_TIMEOUT_SECONDS=120
# SHINKU_LLM_HTTP_ATTEMPTS=2
# SHINKU_LLM_RETRY_BACKOFF_SECONDS=0.8
# SHINKU_LLM_STREAM_ATTEMPTS=2
# SHINKU_LLM_STREAM_RETRY_DELAY_SECONDS=1
# SHINKU_LLM_DEFAULT_MAX_TOKENS=1024
# Context budget: observe logs metadata only; enforce trims oldest chat history when a model window is configured.
# Estimates are not provider token usage. Set the actual context window for each model before enforce.
# SHINKU_LLM_CONTEXT_BUDGET_MODE=observe
# SHINKU_LLM_CONTEXT_WINDOW_TOKENS=0
# SHINKU_LLM_MODEL_CONTEXT_WINDOWS_JSON={"model-id":32768}
# SHINKU_LLM_OUTPUT_RESERVE_TOKENS=2048
# SHINKU_LLM_CONTEXT_MARGIN_TOKENS=1024
# SHINKU_LLM_IMAGE_ESTIMATE_TOKENS=1024
# Only active in enforce mode; original tool results remain in task records.
# SHINKU_AGENT_TOOL_RESULT_MAX_CHARS=6000
# SHINKU_AGENT_FEEDBACK_MAX_CHARS=12000
# SHINKU_LLM_SYSTEM_CACHE_SLOTS=4
# SHINKU_LLM_CIRCUIT_FAILURE_THRESHOLD=3
# SHINKU_LLM_CIRCUIT_BASE_COOLDOWN_SECONDS=60
# SHINKU_LLM_CIRCUIT_MAX_COOLDOWN_SECONDS=600
# SHINKU_QQ_AGENT_MAX_ROUNDS=6
# Generic Agent work can run in a durable, quiet background queue. Chat and
# lightweight perception keep their current paths; this does not raise rounds.
# SHINKU_QQ_AGENT_ASYNC_ENABLED=false
# 每段仍用 SHINKU_QQ_AGENT_MAX_ROUNDS；自动跨段不会刷新整项任务预算。
# Host selects light/standard/heavy from validated task structure; these cap each allocation.
# Explicit /agent resume TASK standard|heavy grants another allocation, retaining usage and receipts.
# SHINKU_QQ_AGENT_ADAPTIVE_BUDGET_ENABLED=true
# SHINKU_QQ_AGENT_TASK_MAX_MODEL_REQUESTS=240
# SHINKU_QQ_AGENT_TASK_MAX_TOKENS=1800000
# SHINKU_QQ_AGENT_TASK_MAX_TOOLS=256
# SHINKU_QQ_AGENT_TASK_MAX_ACTIVE_SECONDS=5400
# Total admitted jobs (running + queued); one tool worker in async mode.
# SHINKU_QQ_AGENT_ASYNC_QUEUE_LIMIT=8
# Safety cap is 64; raise the per-request value above 6 only for tasks that need it.
# Agent planner context can be tuned without changing code.
# SHINKU_QQ_AGENT_HISTORY_TURNS=12
# SHINKU_QQ_AGENT_RECENT_CONTEXT_MESSAGES=8
# Pending tool approval lifetime in seconds.
# SHINKU_QQ_AGENT_APPROVAL_TTL_SECONDS=300
# Optional local persistence for pending approvals. Leave empty to keep them in memory.
# The file may contain exact tool arguments, so treat it as sensitive local state.
# SHINKU_QQ_AGENT_APPROVAL_STORE_PATH=
# SHINKU_QQ_AGENT_TEMPERATURE=0.7
# SHINKU_QQ_AGENT_PROMPT_CACHE_KEY=shinku:qq:v1
# Optional external runtime extension. Leave empty in the public distribution.
# A private launcher may point this at a local module outside the release tree.
# SHINKU_RUNTIME_EXTENSION_MODULE=
# Optional read-only runtime change awareness. The private launcher enables this
# automatically and points it at the public core plus private extension code.
# It records hashes and tool names only, never source text or secret values.
# SHINKU_CHANGE_AWARENESS_ENABLED=false
# SHINKU_CHANGE_SCAN_ROOTS=
# SHINKU_CHANGE_SNAPSHOT_PATH=
# SHINKU_CHANGE_SCAN_EXTENSIONS=py,pyi,js,jsx,ts,tsx,json,toml,yaml,yml
# Final text is split at sentence boundaries; final full stops are removed
# from each QQ bubble, while ! and ? remain. Set false to keep all periods.
# SHINKU_QQ_REPLY_STRIP_FINAL_PERIODS=true
# SHINKU_QQ_REPLY_SHORT_MAX_SEGMENTS=2
# SHINKU_QQ_REPLY_LONG_MAX_SEGMENTS=4
# SHINKU_QQ_REPLY_MAX_SEGMENT_CHARS=600
# SHINKU_QQ_REPLY_SEGMENT_DELAY_SECONDS=0
# Chat flow is a soft conversation-depth hint. It does not change the existing
# reply length thresholds; state stays in memory and expires after the TTL.
# SHINKU_QQ_CHAT_FLOW_ENABLED=true
# SHINKU_QQ_CHAT_FLOW_TTL_SECONDS=600
# SHINKU_QQ_CHAT_FLOW_COOLDOWN_TURNS=1
# SHINKU_QQ_CHAT_FLOW_VOICE_WINDOW=4
# Slash-command control state. Leave the path empty to let the backend place it
# under SHINKU_DATA_ROOT/qq/command_state.json. If set, only local state is
# stored there; no API keys are written. An empty user-id list keeps the
# standalone local bot compatible, while setting it restricts mutating commands.
# SHINKU_QQ_COMMAND_STATE_PATH=
# SHINKU_QQ_COMMAND_USER_IDS=
# SHINKU_QQ_STREAM_ENABLED=false
# SHINKU_QQ_AUTONOMOUS_REPLY_ENABLED=false
# Autonomous attention defaults to deterministic turn-state decisions. The old
# probability sampler remains only as an explicit rollback mode.
# SHINKU_QQ_ATTENTION_MODE=turn_state
# SHINKU_QQ_ATTENTION_MODEL_PATH=
# SHINKU_QQ_ATTENTION_CLASSIFIER_MODE=shadow
# Tool execution risk policy. Unknown tools default to medium and therefore require
# semantic user approval. Only explicitly low-risk calls can bypass the gate.
# SHINKU_TOOL_DEFAULT_RISK=medium
# SHINKU_TOOL_APPROVAL_RISKS=medium,high
# SHINKU_TOOL_RISK_OVERRIDES_JSON={"read_file":"low","browser_open":"high"}

# QQ 入站路由；逗号分隔。未设置时使用真红的默认称呼。
# SHINKU_QQ_BOT_IDS=
# SHINKU_QQ_BOT_NAMES=真红,二阶堂真红,Nikaidou Shinku
# SHINKU_QQ_ALLOW_PRIVATE=true
# SHINKU_QQ_ALLOW_GROUP_NAME_ADDRESS=true
# SHINKU_QQ_ALLOW_GROUP_AT=true
# SHINKU_QQ_ALLOW_REPLY_TO_BOT=true
# SHINKU_QQ_ALLOW_UNADDRESSED_IMAGE=false
# 入站准入：在旁观入库和回复路由之前过滤重复、过期、自消息和忽略对象。
# SHINKU_QQ_EVENT_MAX_AGE_SECONDS=300
# SHINKU_QQ_ALLOW_STALE_EVENTS=false
# SHINKU_QQ_EVENT_DEDUP_TTL_SECONDS=600
# SHINKU_QQ_EVENT_DEDUP_MAX_ENTRIES=4096
# SHINKU_QQ_IGNORED_GROUP_IDS=
# SHINKU_QQ_IGNORED_USER_IDS=
# SHINKU_QQ_IGNORE_SELF_EVENTS=true
# Short window for merging nearby addressed QQ messages into one turn.
# SHINKU_QQ_BATCH_WINDOW_SECONDS=1.5
# Autonomous group turns waiting longer than this are suppressed before generation.
# SHINKU_QQ_AUTONOMOUS_QUEUE_TTL_SECONDS=30
# 图片后续追问的短期继承窗口；只在同一会话且本地判断为视觉追问时生效
# SHINKU_QQ_VISUAL_CONTEXT_TTL_SECONDS=600
# 同一张图片最多自动继承到多少个后续追问，避免旧图污染普通聊天
# SHINKU_QQ_VISUAL_FOLLOWUP_TURNS=3
# Optional deterministic group welcome. Disabled by default; it never calls the
# model and is only honored when SHINKU_QQ_AGENT_SEND_ENABLED=true.
# SHINKU_QQ_GROUP_WELCOME_ENABLED=false
# SHINKU_QQ_GROUP_WELCOME_TEMPLATE=欢迎 {user} 加入群聊。
# SHINKU_QQ_GROUP_WELCOME_GROUP_IDS=
# SHINKU_QQ_GROUP_WELCOME_COOLDOWN_SECONDS=60
# SHINKU_QQ_GROUP_WELCOME_MAX_CHARS=240

# Session response limits. These only affect the session HTTP router.
# SHINKU_SESSION_LIST_LIMIT=50
# SHINKU_SESSION_MESSAGE_LIMIT=120

# OpenAI-compatible gateways whose native tool calling has been verified.
# Format: host:model, comma-separated; * is allowed for one side.
# SHINKU_NATIVE_TOOL_PROVIDER_ALLOWLIST=api.example.com:model-name
# Opt-in for a new gateway/model not yet present in the built-in capability table.
# Verify the gateway first; this bypasses the conservative unknown-model default.
# SHINKU_NATIVE_TOOL_ALLOW_UNKNOWN_MODEL=false

# Optional JSON override for first-run/default model names. Existing saved provider
# records and an explicitly selected model still take precedence.
# SHINKU_PROVIDER_DEFAULT_MODELS_JSON={"glm":"glm-4.5-air","pinaic":"your-model"}
# Optional JSON array for additional compatible provider entries. This is public
# catalog metadata only; do not put API keys here.
# SHINKU_PROVIDER_PRESETS_JSON=[{"id":"my_gateway","label":"我的网关","protocol":"openai","baseUrl":"https://gateway.example/v1","apiKeyRequired":true,"description":"自定义兼容服务","capabilities":["stream","vision"]}]

# ---- 独立记忆层 ----
# 普通聊天只入原始/短期事件层；回忆请求才检索历史。
# SHINKU_MEMORY_ENABLED=true
# SHINKU_MEMORY_DB_PATH=
# 模糊回忆请求才调用一次轻量结构化路由；明确回忆和普通闲聊不额外调用。
# SHINKU_MEMORY_JUDGE_ENABLED=true
# Memory lifecycle and retrieval policy. Defaults preserve current behavior.
# SHINKU_MEMORY_EVENT_TTL_SECONDS=2592000
# SHINKU_MEMORY_RETRIEVAL_LIMIT=5
# SHINKU_MEMORY_MAX_QUERY_TERMS=12
# SHINKU_MEMORY_EVENT_SCAN_LIMIT=800
# SHINKU_MEMORY_FACT_SCAN_LIMIT=120
# SHINKU_MEMORY_MAX_RESULTS=12
# Set false to let the configured memory judge handle ambiguous/explicit recall
# instead of using the deterministic guard shortcuts.
# SHINKU_MEMORY_DETERMINISTIC_GUARDS=true
# SHINKU_MEMORY_RECENT_CONTEXT_CHARS=1800
# SHINKU_MEMORY_MAX_QUERY_CHARS=240
# SHINKU_MEMORY_RENDER_RECORD_CHARS=360
# SHINKU_MEMORY_RENDER_TOTAL_CHARS=2400
# 私人版可启用本地语义索引；公共核心默认不加载 ML 依赖。
# SHINKU_MEMORY_SEMANTIC_ENABLED=false
# SHINKU_MEMORY_MASTER_USER_IDS=
# 额外收录的参与者账号；仅写入署名经历，不赋予主人权限。默认关闭。
# SHINKU_MEMORY_OWNER_PARTICIPANT_IDS=
# 可选本机检索标签，JSON 账号到名称映射；账号仍须在上面的名单中。
# SHINKU_MEMORY_OWNER_PARTICIPANT_LABELS={"example-peer":"同伴"}
# 桌面/QQ 主人私聊自动承接最近 5 分钟，0 关闭，最大 1800 秒。
# 同一 Bot 数据库提交后下一轮直接重读；过期仅退出自动承接，仍可显式检索。
# SHINKU_MEMORY_OWNER_CONTINUITY_SECONDS=300
# SHINKU_MEMORY_SEMANTIC_PROVIDER=huggingface
# SHINKU_MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
# SHINKU_MEMORY_EMBEDDING_DEVICE=
# SHINKU_MEMORY_EMBEDDING_CACHE_DIR=
# SHINKU_MEMORY_EMBEDDING_LOCAL_FILES_ONLY=false
# SHINKU_MEMORY_SEMANTIC_BACKFILL_BATCH_SIZE=128
# SHINKU_MEMORY_SEMANTIC_INDEX_INTERVAL_SECONDS=3
# SHINKU_MEMORY_SEMANTIC_MIN_SCORE=0.22
# ---- 分层记忆生命周期（上线与原文回收是两个独立开关）----
# shadow 只收集证据/提出方案，保留旧 TTL；active 接管受管事件保留期。
# off 保留旧行为。改本文件不会更改私人版的实际配置或运行进程。
# SHINKU_MEMORY_LIFECYCLE_MODE=shadow
# SHINKU_MEMORY_LIFECYCLE_VERSION=ebbinghaus-v1
# SHINKU_MEMORY_LIFECYCLE_L1_SECONDS=604800
# SHINKU_MEMORY_LIFECYCLE_L2_SECONDS=2592000
# SHINKU_MEMORY_LIFECYCLE_MINIMUM_IDLE_TURNS=12
# SHINKU_MEMORY_LIFECYCLE_IDLE_RATE=0.08
# SHINKU_MEMORY_LIFECYCLE_ACTIVE_WINDOW_SECONDS=3600
# SHINKU_MEMORY_LIFECYCLE_REPEAT_INTERVAL_SECONDS=43200
# SHINKU_MEMORY_LIFECYCLE_DAILY_REINFORCEMENT_CAP=2
# SHINKU_MEMORY_LIFECYCLE_RAW_COUNT=3
# SHINKU_MEMORY_LIFECYCLE_RAW_DAYS=2
# SHINKU_MEMORY_LIFECYCLE_REINFORCEMENT_WINDOW_SECONDS=1814400
# SHINKU_MEMORY_LIFECYCLE_RAW_PROTECTION_SECONDS=1814400
# SHINKU_MEMORY_LIFECYCLE_L3_COUNT=6
# SHINKU_MEMORY_LIFECYCLE_L3_DAYS=4
# SHINKU_MEMORY_LIFECYCLE_L3_SPAN_SECONDS=1209600
# SHINKU_MEMORY_LIFECYCLE_SUMMARY_GRACE_SECONDS=604800
# SHINKU_MEMORY_LIFECYCLE_MIGRATION_GRACE_SECONDS=1209600
# SHINKU_MEMORY_LIFECYCLE_BATCH_SIZE=64
# SHINKU_MEMORY_LIFECYCLE_SCAN_INTERVAL_SECONDS=60
# SHINKU_MEMORY_LIFECYCLE_SUMMARY_MAX_CHARS=1200
# SHINKU_MEMORY_LIFECYCLE_AUDIT_LIMIT=2000
# SHINKU_MEMORY_LIFECYCLE_EVIDENCE_RETENTION_SECONDS=5184000
# SHINKU_MEMORY_LIFECYCLE_AUTO_RAW_BUDGET_BYTES=67108864
# 延期 L1 向量改为由已有后台索引器分批持久化；查询只临时编码最近 64 个索引缺口。
# 有效向量随原文有效期保留；后台未启动/未补齐时仍可能缺召回。默认仍为 false。
# SHINKU_MEMORY_LIFECYCLE_DEFER_L1_EMBEDDINGS=false
# Optional B search hints and C current understanding remain off until validated.
# C never infers confirmation for legacy facts or replaces conflicting statements.
# SHINKU_MEMORY_SEARCH_KEYS_ENABLED=false
# SHINKU_MEMORY_CURRENT_UNDERSTANDING_ENABLED=false
# SHINKU_MEMORY_EVIDENCE_PACKAGE_ENABLED=false
# SHINKU_MEMORY_EVIDENCE_MAX_QUERIES=8
# SHINKU_MEMORY_HISTORY_NEEDS_ENABLED=false
# SHINKU_MEMORY_WORKBENCH_TTL_SECONDS=300
# SHINKU_MEMORY_WORKBENCH_MAX_ENTRIES=128
# Unified source projection is opt-in. No production activation is implied by a code update.
# SHINKU_CONTEXT_PROJECTION_ENABLED=false
# Optional one-shot Judge or source-quoted checkpoint, using the saved AUX service.
# Ordinary covered turns add no model calls. Main-model retry remains a standalone experiment.
# SHINKU_CONTEXT_PROJECTION_SEMANTIC_ENABLED=false
# SHINKU_CONTEXT_PROJECTION_CANDIDATE_LIMIT=64
# SHINKU_CONTEXT_PROJECTION_SOURCE_LIMIT=24
# SHINKU_CONTEXT_PROJECTION_MAX_CHARS=10000
# SHINKU_CONTEXT_PROJECTION_RETRIEVAL_MS=3000
# SHINKU_CONTEXT_PROJECTION_SEMANTIC_TIMEOUT_MS=30000
# SHINKU_CONTEXT_PROJECTION_SEMANTIC_DAILY_CALLS=64
# SHINKU_CONTEXT_PROJECTION_MAINTENANCE_BATCH=256
# SHINKU_CONTEXT_PROJECTION_CACHE_ENTRIES=128
# SHINKU_CONTEXT_PROJECTION_CACHE_SECONDS=3600
# 额外语义核验发送有限来源片段到现有 AUX 服务；默认关闭，需接受隐私/费用。
# 摘要仍仅本地抽取，不会隐式发送给云模型。
# SHINKU_MEMORY_LIFECYCLE_SEMANTIC_REVIEW_ENABLED=false
# SHINKU_MEMORY_LIFECYCLE_REVIEW_CANDIDATES=6
# SHINKU_MEMORY_LIFECYCLE_REVIEW_QUEUE_SIZE=16
# SHINKU_MEMORY_LIFECYCLE_REVIEW_TIMEOUT_SECONDS=20
# SHINKU_MEMORY_LIFECYCLE_REVIEW_DAILY_CALLS=64
# SHINKU_MEMORY_LIFECYCLE_REVIEW_MIN_CONFIDENCE=0.9
