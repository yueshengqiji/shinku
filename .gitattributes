# Keep source snapshots consistent across Windows and Linux.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.patch -text
*.cmd text eol=crlf
*.bat text eol=crlf
